{
  "name": "@openim/electron-client-sdk",
  "version": "3.8.3-patch.15.1",
  "description": "OpenIM SDK for Electron",
  "source": "src/index.ts",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "render": [
        "lib/render.d.ts"
      ],
      "preload": [
        "lib/preload.d.ts"
      ],
      "lib/render": [
        "lib/render.d.ts"
      ],
      "lib/preload": [
        "lib/preload.d.ts"
      ],
      "lib/types/*": [
        "lib/types/*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./render": {
      "types": "./lib/render.d.ts",
      "import": "./lib/render.mjs",
      "require": "./lib/render.cjs.js"
    },
    "./preload": {
      "types": "./lib/preload.d.ts",
      "import": "./lib/preload.mjs",
      "require": "./lib/preload.js"
    },
    "./lib/render": {
      "types": "./lib/render.d.ts",
      "import": "./lib/render.mjs",
      "require": "./lib/render.cjs.js"
    },
    "./lib/preload": {
      "types": "./lib/preload.d.ts",
      "import": "./lib/preload.mjs",
      "require": "./lib/preload.js"
    },
    "./lib/types/*": {
      "types": "./lib/types/*.d.ts"
    }
  },
  "files": [
    "lib/**/*",
    "assets/**/*"
  ],
  "scripts": {
    "build": "rimraf lib && rollup -c && tsc-alias",
    "cm": "cz",
    "lint": "eslint ./src/ --fix",
    "semantic-release": "semantic-release",
    "test:contract": "node scripts/check-package-contract.mjs && node scripts/check-native-abi-contract.mjs && node scripts/check-event-contract.mjs",
    "test:consumer": "tsc --noEmit -p test/tsconfig.consumer.json",
    "test:native-smoke": "electron test/native-smoke.cjs",
    "test:package": "node scripts/check-packed-package.mjs",
    "test:render-surface": "node test/render-surface.cjs",
    "test:watch": "jest --watch",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:contract"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenIMSDK/openim-sdk-electron.git"
  },
  "license": "AGPL-3.0-only",
  "author": {
    "name": "blooming",
    "email": "blooming2477@gmail.com",
    "url": "https://github.com/Bloomingg"
  },
  "engines": {
    "node": ">=18.0"
  },
  "keywords": [
    "openim"
  ],
  "bugs": {
    "url": "https://github.com/OpenIMSDK/openim-sdk-electron/issues"
  },
  "homepage": "https://github.com/OpenIMSDK/openim-sdk-electron#readme",
  "devDependencies": {
    "@commitlint/cli": "^16.2.4",
    "@commitlint/config-conventional": "^16.2.4",
    "@openim/wasm-client-sdk": "3.8.3-patch.15.1",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/ffi-napi": "^4.0.10",
    "@types/node": "^18.19.0",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "conventional-changelog-conventionalcommits": "^5.0.0",
    "electron": "^42.8.1",
    "eslint": "^7.25.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.4.0",
    "husky": "^6.0.0",
    "jest": "^27.2.0",
    "lint-staged": "^10.5.4",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "semantic-release": "^19.0.2",
    "tsc-alias": "^1.7.0",
    "typescript": "^5.2.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@commitlint/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.ts": "eslint --cache --cache-location .eslintcache --fix"
  },
  "dependencies": {
    "koffi": "2.8.0"
  },
  "peerDependencies": {
    "@openim/wasm-client-sdk": ">=3.8.3-patch.15.1 <3.9.0",
    "electron": ">=12.0.0"
  }
}
